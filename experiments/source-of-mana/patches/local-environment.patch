 func CallServer(methodName : StringName, args : Array, peerID : int, actionDelta : int = NetworkCommons.DelayDefault) -> bool:
+	if not Client:
+		# RPC arguments are untrusted; use the sender from the polling transport.
+		for server in [WebSocketServer, ENetServer, WebRTCServer]:
+			if server:
+				var sender: int = server.multiplayerAPI.get_remote_sender_id()
+				if sender > 0:
+					peerID = sender
+					break
+		if not NimrodBridge.Allowed(Peers.GetPeer(peerID), methodName, args):
+			if methodName in ["CreateAccount", "LoginWithPassword", "LoginWithToken"]:
+				AuthError(NetworkCommons.AuthError.ERR_TOKEN, peerID)
+			return false
 	if not Peers.Footprint(peerID, methodName, actionDelta):
 		return false
 	if Client and not Client.isOffline:
